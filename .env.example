PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_attendance_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

QR_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
QR_ROTATION_SECONDS=10

CORS_ORIGIN=http://localhost:5173

# Public URL of the deployed frontend (used for password reset links)
FRONTEND_URL=http://localhost:5173

# Password reset tokens expire after this many minutes
RESET_TOKEN_EXPIRES_MINUTES=60

# Outgoing mail (leave MAIL_HOST empty to log reset links
# to the server console instead of sending email)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Attendify <no-reply@example.com>
