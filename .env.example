PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_attendance_db
DB_USER=root
DB_PASSWORD=

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

QR_SECRET=CHANGE_THIS_TO_ANOTHER_LONG_RANDOM_SECRET
QR_ROTATION_SECONDS=10

CORS_ORIGIN=http://localhost:5173

# Public URL of the deployed frontend (used for password reset links)
FRONTEND_URL=http://localhost:5173

# Password reset tokens expire after this many minutes
RESET_TOKEN_EXPIRES_MINUTES=60

# Outgoing mail (leave MAIL_HOST empty to log reset links
# to the server console instead of sending email)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Attendify <no-reply@example.com>

# Weekly WhatsApp attendance summaries (Twilio WhatsApp API).
# The server keeps running normally when WHATSAPP_ENABLED
# is not "true": the job is skipped gracefully and nothing
# is sent. Secrets stay on the backend, never in the frontend.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
WHATSAPP_TIMEZONE=Africa/Cairo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number in E.164 with whatsapp: prefix, e.g. whatsapp:+14155238886.
# For testing, use the Twilio sandbox number and have each
# recipient phone join the sandbox (opt-in) first.
TWILIO_WHATSAPP_FROM=

# Weekly email attendance reports (Resend).
# RESEND_API_KEY lives in Railway only; never commit its value.
RESEND_API_KEY=
# Production sender on a verified domain,
# e.g. Smart Attendance <reports@your-domain>
EMAIL_FROM=
APP_NAME=Smart Attendance

# Weekly email schedule defaults (overridable at runtime via
# PATCH /api/admin/weekly-reports/settings, stored in DB).
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_DAY=5
WEEKLY_REPORT_TIME=18:00
WEEKLY_REPORT_TIMEZONE=Africa/Cairo
